# Copy to `.env` and adjust as needed. Consumed by docker-compose and, if you
# `source` it, by the gateway process.

# --- Keycloak admin console (local dev only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Gateway runtime ---
GATEWAY_PORT=8080
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/rintellix

# --- Downstream services ---
MS_CORE_DATA_URI=http://localhost:8081
MS_RISK_ENGINE_URI=http://localhost:8082
